          "显示刷新与首帧触发"
        ],
        "mechanism": [
          "SurfaceFlinger 组织图层合成",
          "HWC validate/present 完成硬件合成协商与提交"
        ],
        "output": [
          "可供 Yocto Host 显示栈继续处理的合成结果",
          "首帧 submit/present 观测事件"
        ],
        "observations": [
          "SurfaceFlinger/HWC validate、present 返回",
          "首帧提交时间与失败码"
        ],
        "limits": [
          "资料只支撑参考链路，当前车型的 displayId、buffer 共享细节和完整时序待版本资料确认"
